// conf/slurm.config — Execution on a SLURM cluster.
// This cluster has a single partition ('compute'): 7-day limit, 40 CPUs and 188 GB per node.

executor {
    name            = 'slurm'
    queueSize       = 40           // max jobs queued/running at once
    submitRateLimit = '20/1min'    // be gentle with the scheduler
}

process {

    // Single partition on this cluster; applies to every process unless overridden below.
    queue = 'compute'

    // Heavy step: Pfam / HMMER clustering (loads the Pfam DB into memory with --usemem).
    withName: pfam_clustering {
        cpus   = 16
        memory = '120 GB'
        time   = '7d'
    }

    // eggNOG-mapper (uses --cpu = params.hmmer_cpu, plus DIAMOND).
    withName: emapper {
        cpus   = 8
        memory = '32 GB'
        time   = '2d'
    }

    // Per-family steps: alignment, trimming inputs, gene trees, MMseqs2, OGD...
    withLabel: 'medium' {
        cpus   = 4
        memory = '16 GB'
        time   = '2d'
    }

    // Light steps: mkdir, trimming, annotation merge, summary.
    withLabel: 'fast' {
        cpus   = 1
        memory = '12 GB'
        time   = '6h'
    }
}