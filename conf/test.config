// conf/test.config — Datos de prueba mínimos para un smoke-test.
//
//     nextflow run . -profile test,local
//
// Usa el FASTA de ejemplo incluido en el repo (data/Dickeya.fa) y recursos
// reducidos. OJO: las bases de datos Pfam y de taxonomía NO se incluyen en el
// repositorio por tamaño; descárgalas (ver README) y ajusta las rutas abajo
// o pásalas por línea de comandos:
//     nextflow run . -profile test,local --pfam_db ... --ogd_taxonomy_db ...

params {
    input = "${projectDir}/data/Dickeya.fa"

    // Rellena estas rutas tras descargar el paquete de datos (carpeta data/):
    pfam_db         = "${projectDir}/data/pfam/Pfam-A.hmm"
    pfam_datadir    = "${projectDir}/data"
    ogd_taxonomy_db = "${projectDir}/data/ete_taxonomy/e6.taxa.sqlite"

    general_output  = "${projectDir}/results_test"

    // Recursos modestos para que corra en un portátil
    hmmer_num_servers = 1
    hmmer_num_workers = 2
    hmmer_cpu         = 2
    mmseqs_threads    = 2
    memory            = 2.GB
}