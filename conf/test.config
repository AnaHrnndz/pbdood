// conf/test.config — Minimal test data for a smoke test.
//
//     nextflow run . -profile test,local
//
// Uses the example FASTA bundled in the repo (data/Dickeya.fa) and reduced
// resources. NOTE: the Pfam and taxonomy databases are NOT included in the
// repository due to their size; download them (see README) and adjust the
// paths below, or pass them on the command line:
//     nextflow run . -profile test,local --pfam_db ... --ogd_taxonomy_db ...

params {
    input = "${projectDir}/data/Dickeya.fa"

    // Fill in these paths after downloading the data bundle (data/ folder):
    pfam_db         = "${projectDir}/data/pfam/Pfam-A.hmm"
    pfam_datadir    = "${projectDir}/data"
    ogd_taxonomy_db = "${projectDir}/data/ete_taxonomy/e6.taxa.sqlite"

    general_output  = "${projectDir}/results_test"

    // Modest resources so it runs on a laptop
    hmmer_num_servers = 1
    hmmer_num_workers = 2
    hmmer_cpu         = 2
    mmseqs_threads    = 2
    memory            = 2.GB
}