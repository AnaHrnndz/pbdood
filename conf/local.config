// conf/local.config — Local execution (single node/machine).
// Defines only the executor and per-process/label resources.
// Pipeline parameters live in nextflow.config (defaults) and are overridden
// from the command line with --param value.

executor {
    name      = 'local'
    queueSize = 10
}

process {

    withName: pfam_clustering {
        cpus   = 10
        memory = '12 GB'
    }

    withLabel: 'medium' {
        cpus   = 1
        memory = '2 GB'
    }

    withLabel: 'fast' {
        cpus   = 1
        memory = '2 GB'
    }
}