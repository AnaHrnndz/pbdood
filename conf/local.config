// conf/local.config — Ejecución local (un solo nodo/máquina).
// Solo define el ejecutor y los recursos por proceso/etiqueta.
// Los parámetros del pipeline viven en nextflow.config (defaults) y se
// sobreescriben desde la línea de comandos con --param valor.
 
executor {
    name      = 'local'
    queueSize = 10
}
 
process {
 
    withName: pfam_clustering {
        cpus   = 10
        memory = '12 GB'
    }
 
    withLabel: 'medium' {
        cpus   = 1
        memory = '2 GB'
    }
 
    withLabel: 'fast' {
        cpus   = 1
        memory = '2 GB'
    }
}
 