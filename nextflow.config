// nextflow.config — Main configuration for PBDOOD
//
// Typical usage (conda):
//     conda env create -f environment.yml && conda activate pbdood
//     nextflow run . -profile local \
//         --input data/Dickeya.fa \
//         --pfam_datadir /path/data \
//         --ogd_taxonomy_db /path/e6.taxa.sqlite
//
// Available profiles: local, slurm, test
// Combine the execution profile with the test data:  -profile local,test

manifest {
    name            = 'PBDOOD'
    author          = 'Ana Hernandez Plaza'
    description     = 'Phylogeny-based Domain-oriented Orthology Delineation'
    homePage        = 'https://github.com/AnaHrnndz/pbdood'
    mainScript      = 'DOOD.nf'
    nextflowVersion = '>=23.04.0'
}

params {

    // === Inputs ==============================================================
    input            = null                         // (required) FASTA of proteomes (headers: taxid.seqname)
    pfam_datadir     = null                         // (required) path to the data/ folder; Pfam DB is read from <pfam_datadir>/pfam/Pfam-A.hmm
    ogd_taxonomy_db  = null                         // (required) e6.taxa.sqlite (NCBI taxonomy for OGD)
    emapper_dir      = null                         // (optional) eggnog-mapper data dir; if unset, functional annotation is skipped
    entry            = null                          // workflow to run: null (full pipeline), 'ogd_rerun', or 'summary_only'
    // input_dir        = null                          // for --entry ogd_rerun: read previous trees/clustering from here (defaults to general_output)

    // === Outputs ============================================================
    // Define an explicit path here (or pass --general_output ...) to save
    // results elsewhere; otherwise they go to <repo>/results.
    general_output       = "${projectDir}/results"
    clustering_output    = "${params.general_output}/clustering/"
    fastas_output        = "${params.general_output}/clustering/fastas/"
    phylogenomics_output = "${params.general_output}/phylogenomics/"
    orthology_output     = "${params.general_output}/orthology/"

    // === Code paths (resolved inside the repo itself) ========================
    bin_dir        = "${projectDir}/bin/"
    ogd_dir        = "${projectDir}/external/OG_Delineation/"   // placed by install.sh
    python_version = "python"

    // === Tool parameters =====================================================
    // HMMER / eggnog-mapper
    hmmer_num_servers = 2
    hmmer_num_workers = 3
    hmmer_cpu         = 6
    // FAMSA
    famsa_threads     = 1
    // MMseqs2
    mmseqs_threads    = 2
    mmseqs_coverage   = 0.3
    mmseqs_min_seq_id = 0.3
    sensitivity       = 7
    cov_mode          = 2
    cluster_mode      = 0
    // OGD
    ogd_rooting        = 'MinVar'
    ogd_sp_delimitator = '.'
    ogd_sp_overlap     = 0.1
    ogd_sp_lost        = 0.7

    // === Default resources (used by memory { params.memory * task.attempt }) =
    memory = 4.GB
    time   = null
}

// Traces and reports 
trace    { enabled = true; overwrite = true; file = "${params.general_output}/pipeline_info/trace.txt" }
timeline { enabled = true; overwrite = true; file = "${params.general_output}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.general_output}/pipeline_info/report.html" }

profiles {

    // --- Execution environment (pick one) ------------------------------------
    local { includeConfig 'conf/local.config' }   // your own machine/server
    slurm { includeConfig 'conf/slurm.config' }   // SLURM cluster

    // --- Optional: bundled test dataset --------------------------------------
    test  { includeConfig 'conf/test.config' }
}