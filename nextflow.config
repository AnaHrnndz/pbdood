// nextflow.config — Main configuration for PBDOOD
//
// Typical usage (conda, recommended):
//     bash install.sh && conda activate pbdood
//     nextflow run . -profile local \
//         --input data/Dickeya.fa \
//         --pfam_db /path/Pfam-A.hmm \
//         --pfam_datadir /path/data \
//         --ogd_taxonomy_db /path/e6.taxa.sqlite
//
// Available profiles: local, slurm, conda, docker, apptainer, test
// They can be combined:  -profile test,local

manifest {
    name            = 'PBDOOD'
    author          = 'Ana Hernandez Plaza'
    description     = 'Phylogeny-based Domain-oriented Orthology Delineation'
    homePage        = 'https://github.com/AnaHrnndz/pbdood'
    mainScript      = 'DOOD.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

params {

    // === Inputs (the user MUST provide these) ================================
    input            = null                         // FASTA of proteomes (headers: taxid.seqname)
    pfam_db          = null                         // Pfam-A.hmm
    pfam_datadir     = null                         // data/ folder with pfam/ and eggnog resources
    emapper_dir      = null                         // (see README note about clustering.nf)
    ogd_taxonomy_db  = null                         // e6.taxa.sqlite (NCBI taxonomy for OGD)
    input_tree       = null                         // only for -entry run_smartview

    // === Outputs (derived from general_output; keep the trailing slash) ======
    general_output       = "${projectDir}/results"
    clustering_output    = "${params.general_output}/clustering/"
    fastas_output        = "${params.general_output}/clustering/fastas/"
    phylogenomics_output = "${params.general_output}/phylogenomics/"
    orthology_output     = "${params.general_output}/orthology/"

    // === Code paths (resolved inside the repo itself) ========================
    bin_dir        = "${projectDir}/bin/"
    ogd_dir        = "${projectDir}/external/OG_Delineation/"   // placed by install.sh
    python_version = "python"

    // === Tool parameters =====================================================
    // HMMER / eggnog-mapper
    hmmer_num_servers = 2
    hmmer_num_workers = 3
    hmmer_cpu         = 6
    // FAMSA
    famsa_threads     = 1
    // MMseqs2
    mmseqs_threads    = 2
    mmseqs_coverage   = 0.3
    mmseqs_min_seq_id = 0.3
    sensitivity       = 7
    cov_mode          = 2
    cluster_mode      = 0
    // OGD
    ogd_rooting        = 'MinVar'
    ogd_sp_delimitator = '.'
    ogd_sp_overlap     = 0.1
    ogd_sp_lost        = 0.7

    // === Default resources (used by memory { params.memory * task.attempt }) =
    memory = 4.GB
    time   = null
}

// Traces and reports (useful as supplementary material for the thesis)
trace    { enabled = true; overwrite = true; file = "${params.general_output}/pipeline_info/trace.txt" }
timeline { enabled = true; overwrite = true; file = "${params.general_output}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.general_output}/pipeline_info/report.html" }

profiles {

    // --- Dependency management ------------------------------------------------
    // Recommended: use install.sh + 'conda activate pbdood' and do NOT pass
    // -profile conda (the tools will already be on PATH). This profile is for
    // those who prefer Nextflow to manage the environment itself:
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }
    docker {
        docker.enabled = true
        process.container = 'ghcr.io/anahrnndz/pbdood:1.0.0'
    }
    apptainer {
        apptainer.enabled = true
        process.container = 'ghcr.io/anahrnndz/pbdood:1.0.0'
    }

    // --- Executors -----------------------------------------------------------
    local { includeConfig 'conf/local.config' }
    slurm { includeConfig 'conf/slurm.config' }

    // --- Test data -----------------------------------------------------------
    test  { includeConfig 'conf/test.config' }
}