// nextflow.config — Configuración principal de PBDOOD
//
// Uso típico (conda, recomendado):
//     bash install.sh && conda activate pbdood
//     nextflow run . -profile local \
//         --input data/Dickeya.fa \
//         --pfam_db /ruta/Pfam-A.hmm \
//         --pfam_datadir /ruta/data \
//         --ogd_taxonomy_db /ruta/e6.taxa.sqlite
//
// Perfiles disponibles: local, slurm, conda, docker, apptainer, test
// Se pueden combinar:  -profile test,local

manifest {
    name            = 'PBDOOD'
    author          = 'Ana Hernández Plaza'
    description     = 'Phylogeny-based Domain-oriented Orthology Delineation'
    homePage        = 'https://github.com/AnaHrnndz/pbdood'
    mainScript      = 'DOOD.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

params {

    // === Entradas (el usuario DEBE proporcionarlas) ==========================
    input            = null                         // FASTA de proteomas (cabeceras taxid.seqname)
    pfam_db          = null                         // Pfam-A.hmm
    pfam_datadir     = null                         // carpeta data/ con pfam/ y recursos eggnog
    emapper_dir      = null                         // (ver nota en README sobre clustering.nf)
    ogd_taxonomy_db  = null                         // e6.taxa.sqlite (taxonomía NCBI para OGD)
    input_tree       = null                         // solo para -entry run_smartview

    // === Salidas (derivadas de general_output; mantienen la barra final) =====
    general_output       = "${projectDir}/results"
    clustering_output    = "${params.general_output}/clustering/"
    fastas_output        = "${params.general_output}/clustering/fastas/"
    phylogenomics_output = "${params.general_output}/phylogenomics/"
    orthology_output     = "${params.general_output}/orthology/"

    // === Rutas a código (resueltas dentro del propio repo) ===================
    bin_dir        = "${projectDir}/bin/"
    ogd_dir        = "${projectDir}/external/OG_Delineation/"   // lo coloca install.sh
    python_version = "python"

    // === Parámetros de herramientas ==========================================
    // HMMER / eggnog-mapper
    hmmer_num_servers = 2
    hmmer_num_workers = 3
    hmmer_cpu         = 6
    // FAMSA
    famsa_threads     = 1
    // MMseqs2
    mmseqs_threads    = 2
    mmseqs_coverage   = 0.3
    mmseqs_min_seq_id = 0.3
    sensitivity       = 7
    cov_mode          = 2
    cluster_mode      = 0
    // OGD
    ogd_rooting       = 'MinVar'
    ogd_sp_delimitator = '.'
    ogd_sp_overlap    = 0.1
    ogd_sp_lost       = 0.7

    // === Recursos por defecto (usados por memory { params.memory * task.attempt }) ===
    memory = 4.GB
    time   = null
}

// Trazas y reportes (útiles para el material suplementario de la tesis)
trace    { enabled = true; overwrite = true; file = "${params.general_output}/pipeline_info/trace.txt" }
timeline { enabled = true; overwrite = true; file = "${params.general_output}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.general_output}/pipeline_info/report.html" }

profiles {

    // --- Gestión de dependencias ---------------------------------------------
    // Recomendado: usar install.sh + 'conda activate pbdood' y NO pasar -profile conda
    // (las herramientas ya estarán en el PATH). Este perfil es para quien prefiera
    // que Nextflow gestione el entorno por sí mismo:
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }
    docker {
        docker.enabled = true
        process.container = 'ghcr.io/anahrnndz/pbdood:1.0.0'
    }
    apptainer {
        apptainer.enabled = true
        process.container = 'ghcr.io/anahrnndz/pbdood:1.0.0'
    }

    // --- Ejecutores ----------------------------------------------------------
    local { includeConfig 'conf/local.config' }
    slurm { includeConfig 'conf/slurm.config' }

    // --- Datos de prueba -----------------------------------------------------
    test  { includeConfig 'conf/test.config' }
}